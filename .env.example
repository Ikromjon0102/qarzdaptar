# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring.
# .env fayli .gitignore'da, repoga tushmaydi.

# Django maxfiy kaliti. Yangi kalit yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Productionda False qiling
DJANGO_DEBUG=False

# @BotFather bergan token (eski token repoda ochiq qolgan — /revoke qilib yangisini oling)
BOT_TOKEN=

# Webhook uchun ixtiyoriy maxfiy satr (A-Z a-z 0-9 _ -, 1-256 belgi).
# O'rnatgach: python manage.py set_webhook
TELEGRAM_WEBHOOK_SECRET=

# Sayt domeni (https:// siz) va bot nomi (@ siz)
SITE_DOMAIN=telapp.tunl.uz
BOT_USERNAME=QarzDaptarBot
SUPPORT_USERNAME=ergashev_ikromjon

# Oylik obuna narxi (so'm)
SUBSCRIPTION_PRICE=100000

# Vergul bilan ajratilgan ro'yxatlar. Masalan: ALLOWED_HOSTS=qarzdaptar.uz,www.qarzdaptar.uz
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
